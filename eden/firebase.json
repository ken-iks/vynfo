{
  "hosting": {
    "public": "dist",
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "chichi",
          "region": "us-central1"
        }
      },
      {
        "source": "/video",
        "run": {
          "serviceId": "chichi",
          "region": "us-central1"
        }
      },
      {
        "source": "/segments/**",
        "run": {
          "serviceId": "chichi",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
